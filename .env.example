# ── Required ──────────────────────────────────────────────────────────────────
# Your Discord bot token (from https://discord.com/developers/applications)
DISCORD_TOKEN=your-bot-token-here

# The ID of your Discord server (right-click server icon → Copy Server ID)
GUILD_ID=123456789012345678

# The ID of the channel where daily reservation threads will be posted
# The bot needs Send Messages + Create Public Threads permissions here
RESERVATIONS_CHANNEL_ID=123456789012345678

# ── Optional ──────────────────────────────────────────────────────────────────
# Timezone for scheduling (default: Europe/London)
# Full list: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
TIMEZONE=Europe/London

# Time the daily post goes up each morning (24h format, default: 08:00)
DAILY_POST_HOUR=8
DAILY_POST_MINUTE=0

# Time confirmation DMs are sent on the day of the reservation (default: 09:00)
CONFIRMATION_HOUR=9
CONFIRMATION_MINUTE=0
